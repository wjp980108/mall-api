<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.meet.mapper.goods.consign.ConsignGoodsMapper">

    <!-- 结果映射：商品 + 委托人信息 + 场次名称 -->
    <resultMap id="ConsignGoodsResultMap" type="com.atguigu.meet.model.vo.goods.consign.ConsignGoodsVO">
        <id column="id" property="id"/>
        <result column="goods_name" property="goodsName"/>
        <result column="goods_price" property="goodsPrice"/>
        <result column="member_id" property="memberId"/>
        <result column="session_id" property="sessionId"/>
        <result column="cover_img" property="coverImg"/>
        <result column="cover_img_platform" property="coverImgPlatform"/>
        <result column="detail_img" property="detailImg"/>
        <result column="detail_img_platform" property="detailImgPlatform"/>
        <result column="goods_detail" property="goodsDetail"/>
        <result column="sale_times" property="saleTimes"/>
        <result column="goods_status" property="goodsStatus"/>
        <result column="entrust_status" property="entrustStatus"/>
        <result column="audit_status" property="auditStatus"/>
        <result column="online_status" property="onlineStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="session_name" property="sessionName"/>
        <association property="consignor" javaType="com.atguigu.meet.model.vo.goods.consign.ConsignGoodsVO$ConsignorVO">
            <id column="member_id" property="id"/>
            <result column="username" property="username"/>
            <result column="nickname" property="nickname"/>
            <result column="phone" property="phone"/>
            <result column="avatar" property="avatar"/>
            <result column="avatar_platform" property="avatarPlatform"/>
        </association>
    </resultMap>

    <!-- 公共列片段：商品 + 委托人 + 场次 -->
    <sql id="baseColumnList">
        g.id, g.goods_name, g.goods_price, g.member_id, g.session_id,
        g.cover_img, g.cover_img_platform, g.detail_img, g.detail_img_platform,
        g.goods_detail, g.sale_times,
        g.goods_status, g.entrust_status, g.audit_status, g.online_status, g.create_time, g.update_time,
        u.username, u.nickname, u.phone, u.avatar, u.avatar_platform,
        s.session_name
    </sql>

    <!-- 分页查询：JOIN sys_user 实时获取委托人信息 -->
    <select id="selectConsignGoodsPage" resultMap="ConsignGoodsResultMap">
        SELECT <include refid="baseColumnList"/>
        FROM t_consign_goods g
        LEFT JOIN sys_user u ON g.member_id = u.id AND u.is_deleted = 0
        LEFT JOIN t_session s ON g.session_id = s.id
        WHERE g.is_deleted = 0
        <if test="goodsName != null and goodsName != ''">
            AND g.goods_name LIKE CONCAT('%', #{goodsName}, '%')
        </if>
        <if test="memberId != null">
            AND g.member_id = #{memberId}
        </if>
        <if test="sessionId != null">
            AND g.session_id = #{sessionId}
        </if>
        <if test="goodsStatus != null">
            AND g.goods_status = #{goodsStatus}
        </if>
        <if test="entrustStatus != null">
            AND g.entrust_status = #{entrustStatus}
        </if>
        <if test="auditStatus != null">
            AND g.audit_status = #{auditStatus}
        </if>
        <if test="onlineStatus != null">
            AND g.online_status = #{onlineStatus}
        </if>
        <if test="startTime != null">
            AND g.create_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND g.create_time &lt;= #{endTime}
        </if>
        ORDER BY g.create_time DESC
    </select>

    <!-- 根据ID查询详情：JOIN sys_user 实时获取委托人信息 -->
    <select id="selectConsignGoodsById" resultMap="ConsignGoodsResultMap">
        SELECT <include refid="baseColumnList"/>
        FROM t_consign_goods g
        LEFT JOIN sys_user u ON g.member_id = u.id AND u.is_deleted = 0
        LEFT JOIN t_session s ON g.session_id = s.id
        WHERE g.is_deleted = 0 AND g.id = #{id}
    </select>

    <!--
        C 端在售抢购商品分页：
        上架(online_status=1) + 挂卖中(goods_status=1) + 场次开启(session_status=1)
        + 当前时间在场次每日抢购时间窗口内(CURTIME() BETWEEN rush_start_time AND rush_end_time)
        按 s.sort 升序（场次展示顺序）+ g.create_time 倒序
    -->
    <select id="selectSaleGoodsPage" resultMap="ConsignGoodsResultMap">
        SELECT <include refid="baseColumnList"/>
        FROM t_consign_goods g
        LEFT JOIN sys_user u ON g.member_id = u.id AND u.is_deleted = 0
        INNER JOIN t_session s ON g.session_id = s.id AND s.is_deleted = 0
        WHERE g.is_deleted = 0
          AND g.online_status = 1
          AND g.goods_status = 1
          AND s.session_status = 1
          AND CURTIME() BETWEEN s.rush_start_time AND s.rush_end_time
        ORDER BY s.sort ASC, g.create_time DESC
    </select>

    <!--
        并发安全的条件更新：仅当 goods_status = expectStatus 时才执行修改
        受影响行数 = 0 表示并发冲突（其他线程已先一步改掉了状态）
        member_id / entrust_status / audit_status / online_status 传 null 表示不修改，非 null 则同时更新
        场景：
          下单占用       (id, 2, 1, null,    0, 0, null)   新一轮周期重置委托/审核状态
          上传凭证推进   (id, 3, 2, null,    null, null, null)
          确认收款交买家 (id, 4, 3, buyerId, 0, 0, null)
          取消/删除回滚  (id, 1, expect, sellerId, null, null, null)
          买家申请委托   (id, 5, 4, null,    1, 1, null)
          审核通过上架   (id, 1, 5, null,    null, 2, 1)
          审核驳回退回   (id, 4, 5, null,    0, 3, null)
    -->
    <update id="updateStatusWithCondition">
        UPDATE t_consign_goods cg
        <set>
            cg.goods_status = #{newStatus},
            <if test="memberId != null">
                cg.member_id = #{memberId},
            </if>
            <if test="entrustStatus != null">
                cg.entrust_status = #{entrustStatus},
            </if>
            <if test="auditStatus != null">
                cg.audit_status = #{auditStatus},
            </if>
            <if test="onlineStatus != null">
                cg.online_status = #{onlineStatus},
            </if>
            cg.update_time = NOW()
        </set>
        WHERE cg.id = #{id}
          AND cg.is_deleted = 0
          AND cg.goods_status = #{expectStatus}
    </update>

    <!--
        sale_times SQL 层原子自增
        避免 Java 层 "读旧值→+1→写回" 在并发下的丢失更新问题
    -->
    <update id="incrementSaleTimesById">
        UPDATE t_consign_goods
        SET sale_times = COALESCE(sale_times, 0) + 1,
            update_time = NOW()
        WHERE id = #{id}
          AND is_deleted = 0
    </update>

</mapper>
