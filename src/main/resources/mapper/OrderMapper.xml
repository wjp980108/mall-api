<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.meet.mapper.order.OrderMapper">

    <!-- 结果映射：订单VO -->
    <resultMap id="OrderVOResultMap" type="com.atguigu.meet.model.vo.order.OrderVO">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="goods_id" property="goodsId"/>
        <result column="goods_name" property="goodsName"/>
        <result column="seller_id" property="sellerId"/>
        <result column="seller_name" property="sellerName"/>
        <result column="seller_phone" property="sellerPhone"/>
        <result column="buyer_id" property="buyerId"/>
        <result column="buyer_name" property="buyerName"/>
        <result column="buyer_phone" property="buyerPhone"/>
        <result column="rush_price" property="rushPrice"/>
        <result column="receive_address" property="receiveAddress"/>
        <result column="order_status" property="orderStatus"/>
        <result column="put_commission" property="putCommission"/>
        <result column="coupon_amount" property="couponAmount"/>
        <result column="pay_voucher_url" property="payVoucherUrl"/>
        <result column="pay_voucher_platform" property="payVoucherPlatform"/>
        <result column="pay_deadline" property="payDeadline"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 公共列片段（手机号原文输出，不做脱敏） -->
    <sql id="baseColumnList">
        o.id, o.order_no, o.goods_id, o.goods_name,
        o.seller_id, o.seller_name, o.seller_phone,
        o.buyer_id, o.buyer_name, o.buyer_phone,
        o.rush_price, o.receive_address, o.order_status,
        o.put_commission, o.coupon_amount, o.pay_voucher_url, o.pay_voucher_platform,
        o.pay_deadline, o.create_time, o.update_time
    </sql>

    <!-- 分页查询订单列表 -->
    <select id="selectOrderPage" resultMap="OrderVOResultMap">
        SELECT <include refid="baseColumnList"/>
        FROM t_order o
        WHERE o.is_deleted = 0
        <if test="orderNo != null and orderNo != ''">
            AND o.order_no LIKE CONCAT('%', #{orderNo}, '%')
        </if>
        <if test="goodsName != null and goodsName != ''">
            AND o.goods_name LIKE CONCAT('%', #{goodsName}, '%')
        </if>
        <if test="buyerName != null and buyerName != ''">
            AND o.buyer_name LIKE CONCAT('%', #{buyerName}, '%')
        </if>
        <if test="buyerPhone != null and buyerPhone != ''">
            AND o.buyer_phone LIKE CONCAT('%', #{buyerPhone}, '%')
        </if>
        <if test="sellerName != null and sellerName != ''">
            AND o.seller_name LIKE CONCAT('%', #{sellerName}, '%')
        </if>
        <if test="sellerPhone != null and sellerPhone != ''">
            AND o.seller_phone LIKE CONCAT('%', #{sellerPhone}, '%')
        </if>
        <if test="orderStatus != null">
            AND o.order_status = #{orderStatus}
        </if>
        <if test="startTime != null">
            AND o.create_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND o.create_time &lt;= #{endTime}
        </if>
        ORDER BY o.create_time DESC
    </select>

</mapper>
